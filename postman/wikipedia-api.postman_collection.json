                  "    pm.expect(body.error.code).to.be.oneOf([\"missingparam\", \"nosrsearch\"]);",
                  "    pm.expect(body.error.info).to.include(\"srsearch\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{actionBase}}/w/api.php?action=query&list=search&format=json&formatversion=2",
              "host": [
                "{{actionBase}}"
              ],
              "path": [
                "w",
