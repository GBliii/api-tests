              ],
              "query": [
                {
                  "key": "action",
                  "value": "query"
                },
                {
                  "key": "list",
                  "value": "search"
                },
                {
                  "key": "format",
                  "value": "json"
                },
                {
                  "key": "formatversion",
                  "value": "2"
                }
              ]
            },
            "description": "Negative: list=search without srsearch."
          },
          "response": []
