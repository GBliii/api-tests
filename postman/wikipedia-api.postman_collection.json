              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 (the Action API reports errors in the body)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Error names the missing parameter srsearch\", function () {",
                  "    const body = pm.response.json();",
